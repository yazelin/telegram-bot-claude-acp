# ===== Required =====
# Telegram Bot Token (從 @BotFather 取得)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ===== Authorization =====
# 允許使用的用戶 ID (可選，用逗號分隔多個 ID)
# 留空表示允許所有用戶（私人聊天）
ALLOWED_USER_IDS=123456789,987654321

# Bot 管理員 ID (可選，管理員總是有權限)
ADMIN_USER_ID=123456789

# 允許使用的群組 ID (用逗號分隔多個 ID)
# 群組中需要 @Bot 才會回應
ALLOWED_GROUP_IDS=-1234567890,-9876543210

# ===== Optional =====
# 目錄 glob 模式，用逗號分隔
# 支援萬用字元: * (第一層子目錄), ** (遞迴)
DIRECTORY_PATTERNS=/home/user/projects/*,/home/user/libs/**

# 預設 Claude 模型
DEFAULT_MODEL=claude-sonnet-4
